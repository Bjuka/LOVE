# SANCTUARY · secure edition — secrets & generated files
.env
env.js
*.pem
*.key
*.token
.tokens/

# Media binaries live in Supabase Storage now (scripts/upload-to-storage.mjs).
# Never re-commit photos/audio into the repo — especially not for a public repo.
assets/img/
assets/audio/

# One-time migration tools — kept locally for reference, never published
# (upload-to-storage.mjs = repo→Storage migration, done;
#  purge-media-history.mjs = recovery tool if media ever re-lands in git)
scripts/

# Migration-local secrets
scripts/.service-key

# Backups / archives that might contain secrets
*.zip
*.tar
*.tar.gz

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.zed/
.idea/

# Temp / backups
*.tmp
*.bak
*~
/tmp/
