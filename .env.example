# Copy to .env (gitignored) for local runs, and set the same vars in Vercel → Settings → Environment Variables.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SANCTUARY_PASSWORD_HASH=your-sha256-passcode-hash

# Project reference (Dashboard → Settings → General → Reference ID).
# Used only by api/set-main-password.js — never shipped to the browser.
SUPABASE_PROJECT_REF=your-project-ref

# "true" enables verbose logs locally; production always disables it.
DEBUG=false
